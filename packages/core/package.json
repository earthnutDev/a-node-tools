{
  "type": "module",
  "version": "4.4.1",
  "name": "a-node-tools",
  "private": true,
  "scripts": {
    "b": "rollup --config rollup.config.js && tsc -p tsconfig.types.json",
    "clean:package": "node scripts/clean-package-json.js",
    "build": "jja rm dist && pnpm run b && pnpm run clean:package",
    "build:dev": "rollup --config rollup.dev.config.js",
    "build:local": "node ../../scripts/build-local.js",
    "dev": "jja rm .eg cls && pnpm run build:dev && a_node_tools_dev=all node --unhandled-rejections=strict .eg/index.mjs",
    "push:version": "gvv",
    "push": "gvv",
    "diff": "jja pkg -d",
    "eslint": "jja cls && eslint src",
    "beautify": "pnpm run eslint && pnpm run prettier",
    "prettier": "jja cls && prettier . --write",
    "coverage": "codecov",
    "vjj": "vjj -b",
    "prepublishOnly": "pjj"
  },
  "dependencies": {
    "@color-pen/static": "^1.1.1",
    "@qqi/log": "^1.0.0",
    "a-js-tools": "^2.0.1",
    "a-type-of-js": "^2.0.0",
    "color-pen": "^3.0.0"
  }
}
